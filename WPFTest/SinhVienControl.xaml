<UserControl x:Class="WPFTest.SinhVienControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtHoTen" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="txtThongTin" Grid.Row="1" Margin="0,5,0,5" TextWrapping="Wrap"/>
        <TextBlock x:Name="txtTruong" Grid.Row="2" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
